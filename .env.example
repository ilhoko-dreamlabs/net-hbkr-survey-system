# Neon Postgres pooled connection string. Never expose this with NEXT_PUBLIC_.
DATABASE_URL=

# Vercel Cron sends this value as `Authorization: Bearer ...`.
CRON_SECRET=

# Coarse database-protection ceiling in addition to the per-email limit.
SURVEY_GLOBAL_HOURLY_LIMIT=500

# Google Workspace SMTP (server-side only). Use a Google app password, never
# the mailbox's normal password, and never expose these with NEXT_PUBLIC_.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SURVEY_EMAIL_FROM="Dreamlabs Survey <survey@dreamlabs.co.kr>"
SURVEY_EMAIL_REPLY_TO=survey@dreamlabs.co.kr
SURVEY_SITE_URL=https://survey.hbkr.net
